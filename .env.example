# Reddit API credentials
# Get these at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=worldcup-engine/1.0

# Turso hosted database (replaces local SQLite — persists across routine runs)
# Setup: brew install tursodatabase/tap/turso && turso auth login
#        turso db create worldcup-engine
#        turso db show worldcup-engine --url   → TURSO_DATABASE_URL
#        turso db tokens create worldcup-engine → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://worldcup-engine-xxx.turso.io
TURSO_AUTH_TOKEN=

# Pipeline settings
MAX_ARTICLE_AGE_HOURS=6
MIN_REDDIT_SCORE=50
